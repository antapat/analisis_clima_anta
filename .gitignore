# Repositorio público por lista permitida. Todo archivo nuevo queda local
# hasta que se clasifique expresamente para publicación.
/*
!/.gitignore
!/README.md
!/DESCRIPTION
!/app.R
!/manifest.json
!/codigo_gee_downscaling_clima_anta.js
!/correccion_clima_gee_pisco.R
!/preparar_datos_app.R
!/desplegar_shinyapps.R
!/desplegar_connect_cloud.R
!/desplegar_shinyapps.ps1
!/iniciar_app.ps1
!/netlify.toml
!/AUDITORIA_VALIDEZ_TECNICA_2026-10-21.md
!/VALIDACION_RED_ESTACIONES_2026-10-21.md
!/R/
!/scripts/
!/www/
!/app_data/
!/Clima_Anta/
!/docs/
!/portal/
!/public_data/
!/cloud_lite/

# Solo código y recursos de interfaz en estas carpetas.
/R/*
!/R/*.R
/scripts/*
!/scripts/*.R
!/scripts/build_portal.mjs
/www/*
!/www/custom.css
!/www/logo_anta.jpg

# Solo el paquete preparado que necesita la aplicación completa.
/app_data/*
!/app_data/P_anual_150m.tif
!/app_data/P_anual_wgs84.tif
!/app_data/T_anual_150m.tif
!/app_data/T_anual_wgs84.tif
!/app_data/rasters_display_150m.tif
!/app_data/rasters_display_wgs84.tif
!/app_data/distritos_anta.geojson
!/app_data/distritos_info.rds
!/app_data/distritos_sf.rds
!/app_data/distritos_wgs84.rds
!/app_data/provincia_sf.rds
!/app_data/provincia_wgs84.rds
!/app_data/resumen_distrital.rds
!/app_data/resumen_hidroclimatico_distrital_anta.csv
!/app_data/series_anuales.rds
!/app_data/series_anuales_2001_2025_anta.csv
!/app_data/validacion_red_estaciones.csv

# Los dos TIFF de más de 100 MB se publican en partes verificables.
/Clima_Anta/*
!/Clima_Anta/Estres_Hidrico_Anta_2001_2025.tif
!/Clima_Anta/Estres_y_Balance_Hidrico_30m_PISCO_Anta.tif
!/Clima_Anta/Variabilidad_y_Tendencias_PISCO_Anta_2001_2025.tif
!/Clima_Anta/github_parts/
/Clima_Anta/github_parts/*
!/Clima_Anta/github_parts/manifest.csv
!/Clima_Anta/github_parts/*.part[0-9][0-9]

# Solo productos públicos agregados, generados de forma explícita.
/public_data/*
!/public_data/README.md
!/public_data/series_anuales_2001_2025_anta.csv
!/public_data/resumen_hidroclimatico_distrital_anta.csv
!/public_data/validacion_red_estaciones.csv
!/public_data/distritos_anta.geojson

# Edición agregada y autónoma para Posit Connect Cloud desde GitHub.
/cloud_lite/*
!/cloud_lite/app.R
!/cloud_lite/manifest.json
!/cloud_lite/www/
/cloud_lite/www/*
!/cloud_lite/www/styles.css
!/cloud_lite/www/data/
/cloud_lite/www/data/*
!/cloud_lite/www/data/series_anuales_2001_2025_anta.csv
!/cloud_lite/www/data/resumen_hidroclimatico_distrital_anta.csv
!/cloud_lite/www/data/validacion_red_estaciones.csv
!/cloud_lite/www/data/distritos_anta.geojson

/docs/*
!/docs/*.md

/portal/*
!/portal/index.html
!/portal/datos.html
!/portal/styles.css
.Rproj.user
.Rhistory
.RData
.httr-oauth
.DS_Store
.quarto
